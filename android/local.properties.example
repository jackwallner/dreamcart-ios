# Copy to local.properties and fill in values locally. Never commit keys.
sdk.dir=
REVENUECAT_TEST_KEY=
REVENUECAT_PLAY_KEY=
GOOGLE_WEB_CLIENT_ID=
PLAY_UPLOAD_KEYSTORE=
PLAY_UPLOAD_KEY_ALIAS=
PLAY_UPLOAD_STORE_PASSWORD=
PLAY_UPLOAD_KEY_PASSWORD=
# Lowercase SHA-256 hex of the Play reviewer code (never the code itself):
#   printf '%s' 'the-code' | shasum -a 256
PLAY_REVIEW_CODE_SHA256=
