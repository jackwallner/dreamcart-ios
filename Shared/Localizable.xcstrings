    "DreamCart is a virtual shopping game. Everything here, including coins, items, and delivery, is imaginary and has no cash value." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart لعبة تسوق افتراضية. كل ما فيها خيالي، بما في ذلك العملات والقطع والتوصيل، وليس له قيمة نقدية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart ist ein virtuelles Shopping-Spiel. Alles hier, auch Coins, Artikel und Lieferungen, ist ausgedacht und hat keinen Geldwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart is a virtual shopping game. Everything here, including coins, items, and delivery, is imaginary and has no cash value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart es un juego de compras virtuales. Todo, incluidas las monedas, los artículos y las entregas, es imaginario y no tiene valor monetario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCartはバーチャルショッピングゲームです。コイン、アイテム、お届けなど、すべて架空のもので、現金としての価値はありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart é um jogo de compras virtuais. Tudo aqui, incluindo moedas, itens e entregas, é imaginário e não tem valor em dinheiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart: игра в виртуальный шопинг. Всё здесь вымышленное, включая монеты, вещи и доставку, и не имеет денежной стоимости."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart sanal bir alışveriş oyunudur. Jetonlar, ürünler ve teslimat dahil her şey hayalidir ve nakit değeri yoktur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DreamCart 是一款虚拟购物游戏。这里的一切，包括金币、商品和配送，都是虚拟的，不具有现金价值。"
          }
        }
      }
    },
