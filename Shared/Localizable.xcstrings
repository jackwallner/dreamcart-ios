    "%@ per week. Auto-renews until canceled. Cancel anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ أسبوعيًا. يتجدد تلقائيًا حتى الإلغاء. ألغِ متى شئت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Woche. Abo verlängert sich automatisch bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per week. Auto-renews until canceled. Cancel anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por semana. Renovación automática hasta que canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週%@。キャンセルするまで自動更新されます。「設定」からいつでもキャンセルできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por semana. Renovação automática até cancelar. Cancele quando quiser em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в неделю. Продлевается автоматически до отмены. Отменить можно в любой момент в Настройках."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftalık %@. İptale kadar otomatik yenilenir. İstediğin zaman Ayarlar’dan iptal et."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周%@，自动续订直至取消。可随时在设置中取消。"
          }
        }
      }
    },
