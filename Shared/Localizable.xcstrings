    "Original fashion, dream looks, zero dollars. Fill your cart with everything you'd never actually buy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزياء مميزة وإطلالات الأحلام، بلا أي تكلفة. املأ السلة بكل ما لن تشتريه في الواقع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originelle Mode, Traumlooks, null Dollar. Pack alles in deinen Warenkorb, was du dir sonst nie kaufen würdest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original fashion, dream looks, zero dollars. Fill your cart with everything you'd never actually buy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moda original, looks de ensueño y cero dólares. Llena tu carrito de todo lo que nunca te comprarías de verdad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個性派ファッションも夢のコーデも、無料で楽しめます。実際には買わないものも、カートに入れ放題。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moda original, looks dos sonhos, sem gastar dinheiro. Encha o carrinho virtual com tudo que você nunca compraria de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Необычные вещи, образы мечты и никаких трат. Наполни корзину всем, что не купишь в жизни."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özgün moda, hayalindeki kombinler, sıfır masraf. Gerçekte asla almayacağın her şeyi sepetine doldur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时尚好物，梦中穿搭，分文不花。把平时舍不得买的统统放进购物车。"
          }
        }
      }
    },
