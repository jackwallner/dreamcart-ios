    "Give your dream orders a place to land. This fictional address is saved on this device for checkout flavor only." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امنح طلبات أحلامك وجهة. يُحفظ هذا العنوان الخيالي على جهازك لإضفاء طابع ممتع على إتمام الطلب فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deinen Traumbestellungen ein Ziel. Die Fantasieadresse wird auf diesem Gerät gespeichert und gehört nur zum Spiel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your dream orders a place to land. This fictional address is saved on this device for checkout flavor only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dales un destino a tus pedidos de ensueño. Esta dirección ficticia se guarda en este dispositivo solo para ambientar la compra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夢の注文にお届け先を作りましょう。この架空の住所はお会計の演出用に、このデバイスにのみ保存されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê um destino aos seus pedidos dos sonhos. Este endereço fictício fica salvo neste aparelho só para deixar a finalização mais divertida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть заказам мечты будет куда приземлиться! Этот выдуманный адрес сохранится на устройстве только для атмосферы при оформлении заказа."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hayalindeki siparişlere bir adres ver. Bu hayali adres yalnızca siparişi tamamlama deneyimi için bu cihazda saklanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给梦中订单找个落脚点。这个虚构地址只保存在本设备上，为结算增添乐趣。"
          }
        }
      }
    },
