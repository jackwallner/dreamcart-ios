    "Get one gentle reminder when fresh drops are ready. You can choose the time, and you can change this anytime in Profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على تذكير لطيف واحد عند وصول قطع جديدة. اختر الوقت وغيّره متى شئت من الملف الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst eine kleine Erinnerung, wenn neue Drops da sind. Die Uhrzeit wählst du selbst und kannst sie jederzeit im Profil ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get one gentle reminder when fresh drops are ready. You can choose the time, and you can change this anytime in Profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un recordatorio cuando haya novedades. Elige la hora y cámbiala cuando quieras en Perfil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新着アイテムが登場したら、1回お知らせします。通知の時間は選べて、プロフィールでいつでも変更できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um lembrete quando chegarem novidades. Escolha o horário e altere quando quiser no Perfil."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получай одно ненавязчивое напоминание о новинках. Время можно выбрать и в любой момент изменить в профиле."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni parçalar geldiğinde bir hatırlatma al. Saatini seçebilir, bunu istediğin zaman Profil’den değiştirebilirsin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上新时提醒你一次。你可以选择时间，也能随时在个人资料中更改。"
          }
        }
      }
    },
    "Get started" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ"
          }
        },
