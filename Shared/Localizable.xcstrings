    "Delete your account? This erases your closet, coins, and streak for good." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تحذف حسابك؟ سيؤدي هذا إلى مسح خزانتك وعملاتك وسلسلة أيامك نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account löschen? Dein Kleiderschrank, deine Coins und deine Serie werden endgültig gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your account? This erases your closet, coins, and streak for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar tu cuenta? Se borrarán tu armario, tus monedas y tu racha para siempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しますか？クローゼット、コイン、連続記録が完全に消去されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar sua conta? Seu closet, suas moedas e sua sequência serão apagados para sempre."
