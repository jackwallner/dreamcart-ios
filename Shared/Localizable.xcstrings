    "Playful flourish only. DreamCart is a virtual shopping game, so nothing is ever actually shipped here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجرد لمسة مرحة! DreamCart لعبة تسوق افتراضية، ولن يتم شحن أي شيء فعليًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zum Spaß: DreamCart ist ein virtuelles Shopping-Spiel. Es wird nichts tatsächlich verschickt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playful flourish only. DreamCart is a virtual shopping game, so nothing is ever actually shipped here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es solo parte del juego. DreamCart es un juego de compras virtuales, así que no se envía nada de verdad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お買い物気分を楽しむための演出です。DreamCartはバーチャルショッピングゲームなので、実際に商品が届くことはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É só de brincadeira. DreamCart é um jogo de compras virtuais, então nada é enviado de verdade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это просто для атмосферы. DreamCart: игра в виртуальный шопинг. Настоящей доставки здесь нет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sadece eğlenceli bir detay. DreamCart sanal bir alışveriş oyunudur, hiçbir şey gerçekten gönderilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只是增加一点趣味。DreamCart 是虚拟购物游戏，不会实际寄送任何物品。"
          }
        }
      }
    },
