    "Virtual delivery: no real address is needed and nothing ships. You pay only in coins." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توصيل افتراضي: لا تحتاج إلى عنوان حقيقي، ولن يُشحن أي شيء. تدفع بالعملات فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuelle Lieferung: Du brauchst keine echte Adresse und es wird nichts verschickt. Du zahlst nur mit Coins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual delivery: no real address is needed and nothing ships. You pay only in coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega virtual: no necesitas una dirección real y no se envía nada. Solo pagas con monedas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲーム内のお届けです。実際の住所は不要で、商品の発送はありません。お会計に使うのはコインだけです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrega virtual: não precisa de endereço real e nada é enviado. Você paga só com moedas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виртуальная доставка: настоящий адрес не нужен, товары никуда не отправляются. Оплата только монетами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanal teslimat: Gerçek adres gerekmez, hiçbir şey kargolanmaz. Yalnızca jeton harcarsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟送达：无需真实地址，不会寄送实物。结算只需金币。"
          }
        }
      }
    },
    "We use Sign in with Apple to save your closet and coins. Nothing is shared." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم تسجيل الدخول باستخدام Apple لحفظ خزانتك وعملاتك. لا نشارك أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Mit Apple anmelden“ speichern wir deinen Kleiderschrank und deine Coins. Es wird nichts geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use Sign in with Apple to save your closet and coins. Nothing is shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos Iniciar sesión con Apple para guardar tu armario y tus monedas. No se comparte nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クローゼットとコインの保存にはAppleでサインインを使います。情報が共有されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usamos o Iniciar sessão com a Apple para salvar seu closet e suas moedas. Nada é compartilhado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход с Apple сохраняет твой гардероб и монеты. Мы ни с кем не делимся твоими данными."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dolabını ve jetonlarını kaydetmek için Apple ile Giriş Yap'ı kullanıyoruz. Hiçbir şey paylaşılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们使用“通过 Apple 登录”保存你的衣橱和金币，不会共享任何信息。"
          }
        }
      }
    },
