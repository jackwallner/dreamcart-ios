    "Fresh picks appear as new pieces drop. You can also bring passed items back." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر اختيارات جديدة مع وصول قطع جديدة. ويمكنك أيضًا استعادة القطع التي تخطيتها."
          }
        },
        "de" : {
          "stringUnit" : {
