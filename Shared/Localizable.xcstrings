        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammle deine Lieblingsteile, mixe Marken und style komplette Outfits mit Schmuck, Sonnenbrillen und Hüten. Alles deins."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Own the pieces, mix brands, and style full outfits with jewelry, shades and hats. All yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazte con prendas, mezcla marcas y crea conjuntos completos con joyas, gafas y sombreros. Todo tuyo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムをゲットして、ブランドを自由にミックス。ジュエリーやサングラス、帽子で自分だけのコーデを楽しみましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colecione peças virtuais, misture marcas e monte looks completos com joias, óculos e chapéus. Tudo seu no jogo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Собирай вещи, сочетай бренды и создавай образы с украшениями, очками и головными уборами. Всё твоё."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parçaları kap, markaları karıştır, takılar, güneş gözlükleri ve şapkalarla kombinlerini tamamla. Hepsi senin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把好物收入囊中，混搭各大品牌，再用首饰、墨镜和帽子打造完整穿搭。全是你的。"
          }
        }
      }
    },
