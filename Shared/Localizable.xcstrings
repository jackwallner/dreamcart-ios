      }
    },
    "Sign in to collect coins, fill your cart and keep everything you buy in your closet. Browsing stays free." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول لتجمع العملات وتملأ السلة وتحفظ كل مشترياتك في الخزانة. التصفح مجاني دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, sammle Coins, fülle deinen Warenkorb und bewahre deine Einkäufe im Kleiderschrank auf. Stöbern bleibt kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to collect coins, fill your cart and keep everything you buy in your closet. Browsing stays free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para conseguir monedas, llenar tu carrito y guardar todo lo que compres en tu armario. Explorar sigue siendo gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしてコインを集め、カートに入れてお買い物。ゲットしたアイテムはクローゼットに保存されます。ショップを見るだけなら無料です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre para juntar moedas, encher o carrinho e guardar suas compras virtuais no closet. Explorar continua grátis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войди, чтобы собирать монеты, наполнять корзину и хранить покупки в гардеробе. Смотреть товары можно бесплатно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeton biriktirmek, sepetini doldurmak ve aldıklarını dolabında tutmak için giriş yap. Gezinmek her zaman ücretsiz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录后即可领取金币、装满购物车，并把买下的好物收入衣橱。逛街始终免费。"
          }
        }
      }
    },
