    "Claim a daily drop, spin the wheel, and keep your streak alive. The more you show up, the more you get." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على مكافأة يومية، ولفّ العجلة، وحافظ على سلسلة أيامك. كلما عدت، حصلت على المزيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir täglich deinen Drop, dreh am Rad und halte deine Serie am Laufen. Je öfter du vorbeischaust, desto mehr gibt's."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claim a daily drop, spin the wheel, and keep your streak alive. The more you show up, the more you get."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge tu premio diario, gira la ruleta y mantén tu racha. Cada día que vuelves, ganas más."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デイリーボーナスを受け取って、スピンして、連続記録を伸ばしましょう。毎日遊ぶほど、もらえるものも増えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resgate a recompensa diária, gire a roleta e mantenha sua sequência. Quanto mais você volta, mais ganha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забирай ежедневный подарок, крути колесо и продолжай серию. Чем чаще заходишь, тем больше получаешь!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük sürprizini al, çarkı çevir ve serini sürdür. Ne kadar sık gelirsen o kadar çok kazanırsın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "领取每日好礼，转转盘，保持连续签到。来得越勤，收获越多！"
          }
        }
      }
    },
