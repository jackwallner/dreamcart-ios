    "Browse as long as you like. Sign in when you want to claim daily coins, spin the wheel and keep what you buy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح كما تشاء. سجّل الدخول لتحصل على عملاتك اليومية، وتلفّ العجلة، وتحتفظ بما تشتريه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stöbere, solange du magst. Melde dich an, um tägliche Coins abzuholen, am Rad zu drehen und deine virtuellen Einkäufe zu behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse as long as you like. Sign in when you want to claim daily coins, spin the wheel and keep what you buy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora todo lo que quieras. Inicia sesión para recoger tus monedas diarias, girar la ruleta y guardar lo que compres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなだけショップを見てまわりましょう。毎日のコインの受け取りやスピン、ゲットしたアイテムの保存にはサインインしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore à vontade. Entre na conta quando quiser resgatar moedas diárias, girar a roleta e guardar suas compras virtuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотри сколько хочешь. Войди, когда решишь получать ежедневные монеты, крутить колесо и сохранять покупки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dilediğin kadar gez. Günlük jetonlarını almak, çarkı çevirmek ve aldıklarını saklamak istediğinde giriş yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随便逛，逛多久都行。登录后就能领取每日金币、转转盘，还能收藏买下的宝贝。"
          }
        }
      }
    },
