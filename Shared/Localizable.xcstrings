    "Add a pretend address so your order has somewhere to \"go,\" or skip it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف عنوانًا خياليًا ليكون لطلبك وجهة، أو تخطَّ هذه الخطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge eine Fantasieadresse hinzu, damit deine Bestellung ein Ziel hat, oder überspringe diesen Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a pretend address so your order has somewhere to \"go,\" or skip it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una dirección imaginaria para que tu pedido tenga adónde «ir», o sáltate este paso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "架空の住所を入力して、ご注文の「お届け先」にしましょう。スキップもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um endereço fictício para seu pedido ter para onde “ir” ou pule esta etapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь выдуманный адрес, чтобы заказу было куда «отправиться», или пропусти этот шаг."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siparişinin “gideceği” hayali bir adres ekle ya da bu adımı geç."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填个虚拟地址，让订单有个“去处”，也可以跳过。"
          }
        }
      }
    },
    "Add a shipping address or tap “Skip for now” to continue" : {
