    "Coins are for use inside DreamCart only and have no cash value. All items and delivery are virtual." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العملات للاستخدام داخل DreamCart فقط وليس لها قيمة نقدية. كل القطع افتراضية والتوصيل افتراضي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins gelten nur in DreamCart und haben keinen Geldwert. Alle Artikel und Lieferungen sind virtuell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coins are for use inside DreamCart only and have no cash value. All items and delivery are virtual."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las monedas solo se usan en DreamCart y no tienen valor monetario. Todos los artículos y entregas son virtuales."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインはDreamCart内でのみ使え、現金としての価値はありません。アイテムとお届けはすべて架空のものです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As moedas só podem ser usadas no DreamCart e não têm valor em dinheiro. Todos os itens e entregas são virtuais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монеты действуют только в DreamCart и не имеют денежной стоимости. Все вещи и доставка виртуальные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
